# Inject these into the server process environment. This file is not loaded automatically.
AIMHARDER_USERNAME=
AIMHARDER_PASSWORD=
# Optional for one gym; required for multiple gyms. Use an ID returned by discovery.
# AIMHARDER_DEFAULT_GYM=sample-gym
# Required for date queries. Confirm each gym's IANA zone with the gym or its schedule settings.
# Supplying this mapping asserts user confirmation; it does not grant access to any gym.
# AIMHARDER_GYM_TIME_ZONES={"sample-gym":"Europe/Madrid"}
