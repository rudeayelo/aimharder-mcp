                    },
                    {
                      "type": "text",
                      "id": "gkAwu",
                      "name": "What your AI app receives / paragraph 1",
                      "fill": "$home-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Una app de IA que hayas autorizado puede enviar solicitudes a través de tu conexión y recibir la información resultante. Según lo que preguntes, puede incluir tus reservas, entrenos o actividad registrada.",
                      "lineHeight": 1.65,
                      "fontFamily": "Geist",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "UaAe1",
                      "name": "What your AI app receives / paragraph 2",
                      "fill": "$home-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "La app de IA gestiona tu conversación conforme a sus propias condiciones y política de privacidad. Revocar su acceso a AIHarder detiene esa conexión; no elimina la información que ya haya recibido.",
                      "lineHeight": 1.65,
                      "fontFamily": "Geist",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "xRIed",
                  "name": "Privacy section / Sign-in and security",
