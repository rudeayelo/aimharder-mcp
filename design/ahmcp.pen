    "home-setupTitle": {
      "type": "string",
      "value": [
        {
          "value": "Your account. Connected.",
          "theme": {
            "language": "en"
          }
        },
        {
          "value": "Tu cuenta. Conectada.",
          "theme": {
            "language": "es"
          }
        }
      ]
    },
    "home-setupIntro": {
      "type": "string",
      "value": [
        {
          "value": "Once you’ve accepted your invitation, there are just three things to do.",
          "theme": {
            "language": "en"
          }
        },
        {
          "value": "Después de aceptar tu invitación, estos son los tres pasos.",
          "theme": {
            "language": "es"
          }
        }
      ]
    },
    "home-step1": {
      "type": "string",
      "value": [
        {
          "value": "Connect AimHarder",
          "theme": {
            "language": "en"
          }
        },
        {
          "value": "Conecta AimHarder",
          "theme": {
            "language": "es"
          }
        }
      ]
    },
    "home-step1Body": {
      "type": "string",
      "value": [
        {
          "value": "Link your existing AimHarder account. Keep training with your gym as usual.",
          "theme": {
            "language": "en"
          }
        },
        {
          "value": "Vincula tu cuenta de AimHarder. Sigue entrenando con tu gimnasio como siempre.",
          "theme": {
            "language": "es"
          }
        }
      ]
    },
    "home-step2": {
      "type": "string",
      "value": [
        {
          "value": "Connect your AI chat",
          "theme": {
            "language": "en"
          }
        },
        {
          "value": "Conecta tu chat de IA",
          "theme": {
            "language": "es"
          }
        }
      ]
    },
    "home-step2Body": {
      "type": "string",
      "value": [
        {
          "value": "Follow the guide for ChatGPT, Hermes or another compatible client.",
          "theme": {
            "language": "en"
          }
        },
        {
          "value": "Sigue la guía para ChatGPT, Hermes u otro cliente compatible.",
          "theme": {
            "language": "es"
          }
        }
      ]
    },
    "home-step3": {
      "type": "string",
      "value": [
        {
          "value": "Ask your first question",
          "theme": {
            "language": "en"
          }
        },
        {
          "value": "Haz tu primera pregunta",
          "theme": {
            "language": "es"
          }
        }
      ]
    },
    "home-step3Body": {
      "type": "string",
      "value": [
        {
          "value": "Try: “What classes can I book tomorrow?”",
          "theme": {
            "language": "en"
          }
        },
        {
          "value": "Prueba: «¿A qué clases me puedo apuntar mañana?»",
          "theme": {
            "language": "es"
          }
        }
      ]
    },
    "home-faqTitle": {
      "type": "string",
      "value": [
        {
          "value": "A few things to know.",
          "theme": {
            "language": "en"
          }
        },
        {
          "value": "Algunas cosas que conviene saber.",
          "theme": {
            "language": "es"
          }
        }
      ]
    },
    "home-faqIntro": {
      "type": "string",
      "value": [
        {
          "value": "A little context before you connect.",
          "theme": {
            "language": "en"
          }
        },
        {
          "value": "Un poco de contexto antes de conectar.",
          "theme": {
            "language": "es"
          }
        }
      ]
    },
    "home-q1": {
      "type": "string",
      "value": [
        {
          "value": "How do I get access?",
          "theme": {
            "language": "en"
          }
        },
        {
          "value": "¿Cómo consigo acceso?",
          "theme": {
            "language": "es"
          }
        }
      ]
    },
    "home-a1": {
      "type": "string",
      "value": [
        {
          "value": "The pilot is invitation-only. Open your invitation email to get started. Already have access? Sign in.",
          "theme": {
            "language": "en"
          }
        },
        {
          "value": "El piloto funciona por invitación. Abre el correo de invitación para empezar. ¿Ya tienes acceso? Inicia sesión.",
          "theme": {
            "language": "es"
          }
        }
      ]
    },
    "home-q2": {
      "type": "string",
      "value": [
        {
          "value": "Which AI chats can I use?",
          "theme": {
            "language": "en"
          }
        },
        {
          "value": "¿Qué chats de IA puedo usar?",
          "theme": {
            "language": "es"
          }
        }
      ]
    },
    "home-a2": {
      "type": "string",
      "value": [
        {
          "value": "Start with the guides for ChatGPT and Hermes. Other clients need to meet the connection requirements in their guide.",
          "theme": {
            "language": "en"
          }
        },
        {
          "value": "Empieza con las guías para ChatGPT y Hermes. Los demás clientes deben cumplir los requisitos de conexión indicados en su guía.",
          "theme": {
            "language": "es"
          }
        }
      ]
    },
    "home-q3": {
      "type": "string",
      "value": [
        {
          "value": "What happens to my account details?",
          "theme": {
            "language": "en"
          }
        },
        {
          "value": "¿Qué ocurre con los datos de mi cuenta?",
          "theme": {
            "language": "es"
          }
        }
      ]
    },
    "home-a3": {
      "type": "string",
      "value": [
        {
          "value": "The service stores your AimHarder credentials encrypted and can recover them to authenticate. Your AI chat does not receive them.",
          "theme": {
            "language": "en"
          }
        },
        {
          "value": "El servicio guarda tus credenciales de AimHarder cifradas y puede recuperarlas para autenticarte. Tu chat de IA no las recibe.",
          "theme": {
            "language": "es"
          }
        }
      ]
    },
    "home-q4": {
      "type": "string",
      "value": [
        {
          "value": "Can I disconnect later?",
          "theme": {
            "language": "en"
          }
        },
        {
          "value": "¿Puedo desconectar el acceso después?",
          "theme": {
            "language": "es"
          }
        }
      ]
    },
    "home-a4": {
      "type": "string",
      "value": [
        {
          "value": "Yes. You can disconnect each AI client independently. Disconnecting AimHarder and deleting your Connect account are separate actions.",
          "theme": {
            "language": "en"
          }
        },
        {
          "value": "Sí. Puedes desconectar cada cliente de IA por separado. Desconectar AimHarder y eliminar tu cuenta de Connect son acciones distintas.",
          "theme": {
            "language": "es"
          }
        }
      ]
    },
    "home-q5": {
      "type": "string",
      "value": [
        {
          "value": "Is this an official AimHarder service?",
          "theme": {
            "language": "en"
          }
        },
        {
          "value": "¿Es un servicio oficial de AimHarder?",
          "theme": {
            "language": "es"
          }
        }
      ]
    },
    "home-a5": {
      "type": "string",
      "value": [
        {
          "value": "No. AimHarder Connect is an independent project, not affiliated with AimHarder.",
          "theme": {
            "language": "en"
          }
        },
        {
          "value": "No. AimHarder Connect es un proyecto independiente, sin afiliación con AimHarder.",
          "theme": {
            "language": "es"
          }
        }
      ]
    },
    "home-closing": {
      "type": "string",
      "value": [
        {
          "value": "Bring your training into the conversation.",
          "theme": {
            "language": "en"
          }
        },
        {
          "value": "Lleva tu entrenamiento a la conversación.",
          "theme": {
            "language": "es"
          }
        }
      ]
    },
