                    },
                    {
                      "type": "text",
                      "id": "Ygu2M",
                      "name": "Disconnecting and deleting / paragraph 1",
                      "fill": "$home-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Puedes revocar el acceso de una app de IA, desconectar AimHarder o eliminar tu cuenta de AIHarder. Son opciones distintas.",
                      "lineHeight": 1.65,
                      "fontFamily": "Geist",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "u9KWoO",
                      "name": "Disconnecting and deleting / paragraph 2",
                      "fill": "$home-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Eliminar tu cuenta de AIHarder borra sus datos activos de acceso, las credenciales de conexión y las autorizaciones de los clientes. No elimina tu cuenta de AimHarder, no cancela tus reservas ni borra las conversaciones que conserve un proveedor de IA.",
                      "lineHeight": 1.65,
                      "fontFamily": "Geist",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "PbJnS",
                      "name": "Disconnecting and deleting / paragraph 3",
                      "fill": "$home-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "El borrado de los datos activos y la caducidad de las copias de seguridad son procesos distintos. Los registros de recuperación que impiden restaurar cuentas eliminadas también son independientes de los datos de las cuentas activas.",
                      "lineHeight": 1.65,
                      "fontFamily": "Geist",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "zWCnp",
