                },
                {
                  "type": "frame",
                  "id": "EpJLF",
                  "name": "Privacy section / About this notice",
                  "context": "Anchor #about",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "KsE2Q",
                      "name": "Section heading / About this notice",
                      "fill": "$home-ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "About this notice",
                      "lineHeight": 1.25,
                      "fontFamily": "Geist",
                      "fontSize": 26,
                      "fontWeight": "600",
                      "letterSpacing": -0.5
                    },
                    {
                      "type": "text",
                      "id": "D0oc8N",
                      "name": "About this notice / paragraph 1",
                      "fill": "$home-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "This notice covers the hosted AIHarder service that connects your AimHarder account to AI apps. AIHarder is an independent project and is not affiliated with AimHarder.",
                      "lineHeight": 1.65,
                      "fontFamily": "Geist",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "NnQb3",
                      "name": "About this notice / paragraph 2",
                      "fill": "$home-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "AimHarder and the AI apps you use have their own privacy policies. Those policies cover information they handle through their own services.",
                      "lineHeight": 1.65,
                      "fontFamily": "Geist",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "Z96qJP",
                  "name": "Privacy section / Information we use",
                  "context": "Anchor #information",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "L8UCLB",
                      "name": "Section heading / Information we use",
                      "fill": "$home-ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Information we use",
                      "lineHeight": 1.25,
                      "fontFamily": "Geist",
                      "fontSize": 26,
                      "fontWeight": "600",
                      "letterSpacing": -0.5
                    },
                    {
                      "type": "text",
                      "id": "jFuRO",
                      "name": "Information we use / paragraph 1",
                      "fill": "$home-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Your AIHarder account uses your email address and sign-in information to identify you and secure access. If you choose Google sign-in, information from Google is used to identify that account.",
                      "lineHeight": 1.65,
                      "fontFamily": "Geist",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "FezpJ",
                      "name": "Information we use / paragraph 2",
                      "fill": "$home-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Connecting AimHarder requires your AimHarder credentials and connection settings, including your selected gym. The service retrieves the classes, workouts, bookings and activity information needed to answer requests made through your connection.",
                      "lineHeight": 1.65,
                      "fontFamily": "Geist",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "RPFfi",
                  "name": "Privacy section / Your AimHarder credentials",
                  "context": "Anchor #credentials",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "q3Jfqv",
                      "name": "Section heading / Your AimHarder credentials",
                      "fill": "$home-ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Your AimHarder credentials",
                      "lineHeight": 1.25,
                      "fontFamily": "Geist",
                      "fontSize": 26,
                      "fontWeight": "600",
                      "letterSpacing": -0.5
                    },
                    {
                      "type": "text",
                      "id": "gSwIQ",
                      "name": "Your AimHarder credentials / paragraph 1",
                      "fill": "$home-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Your AIHarder sign-in and your AimHarder connection are separate. The service stores your AimHarder credentials encrypted and can decrypt them when it needs to authenticate to AimHarder. This is recoverable encryption, not end-to-end encryption.",
                      "lineHeight": 1.65,
                      "fontFamily": "Geist",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "U9CRl",
                      "name": "Your AimHarder credentials / paragraph 2",
                      "fill": "$home-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Your AimHarder password is not included in the information returned to your AI app. Enter it only in the account connection form, not in a chat message.",
                      "lineHeight": 1.65,
                      "fontFamily": "Geist",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "fikrm",
                  "name": "Privacy section / What your AI app receives",
                  "context": "Anchor #ai-apps",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "LDzFz",
                      "name": "Section heading / What your AI app receives",
                      "fill": "$home-ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "What your AI app receives",
                      "lineHeight": 1.25,
                      "fontFamily": "Geist",
                      "fontSize": 26,
                      "fontWeight": "600",
                      "letterSpacing": -0.5
                    },
                    {
                      "type": "text",
                      "id": "rZuyn",
                      "name": "What your AI app receives / paragraph 1",
                      "fill": "$home-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "An AI app you authorize can send requests through your connection and receive the resulting information. Depending on what you ask, that can include your bookings, workouts or recorded activity.",
                      "lineHeight": 1.65,
                      "fontFamily": "Geist",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "C5NYE",
                      "name": "What your AI app receives / paragraph 2",
                      "fill": "$home-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The AI app handles your conversation under its own terms and privacy policy. Revoking its access to AIHarder stops that connection; it does not remove information already returned to that app.",
                      "lineHeight": 1.65,
                      "fontFamily": "Geist",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "PEj37",
                  "name": "Privacy section / Sign-in and security",
                  "context": "Anchor #security",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "HSMOK",
                      "name": "Section heading / Sign-in and security",
                      "fill": "$home-ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Sign-in and security",
                      "lineHeight": 1.25,
                      "fontFamily": "Geist",
                      "fontSize": 26,
                      "fontWeight": "600",
                      "letterSpacing": -0.5
                    },
                    {
                      "type": "text",
                      "id": "K7BENj",
                      "name": "Sign-in and security / paragraph 1",
                      "fill": "$home-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The service uses a browser session to keep you signed in. Access granted to an AI app is separate from that browser session, so signing out of the website does not disconnect your AI apps.",
                      "lineHeight": 1.65,
                      "fontFamily": "Geist",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "t6zE2b",
                      "name": "Sign-in and security / paragraph 2",
                      "fill": "$home-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Use the connected-app controls to revoke an app’s access. Keep your account details private and contact support if you believe someone else has accessed your account.",
                      "lineHeight": 1.65,
                      "fontFamily": "Geist",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "GrKQ7",
                  "name": "Privacy section / Disconnecting and deleting",
                  "context": "Anchor #deletion",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "xHNqZ",
                      "name": "Section heading / Disconnecting and deleting",
                      "fill": "$home-ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Disconnecting and deleting",
                      "lineHeight": 1.25,
                      "fontFamily": "Geist",
                      "fontSize": 26,
                      "fontWeight": "600",
                      "letterSpacing": -0.5
                    },
                    {
                      "type": "text",
                      "id": "XYshc",
                      "name": "Disconnecting and deleting / paragraph 1",
                      "fill": "$home-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "You can revoke an AI app’s access, disconnect AimHarder, or delete your AIHarder account. These are separate choices.",
                      "lineHeight": 1.65,
                      "fontFamily": "Geist",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Q8GzvQ",
                      "name": "Disconnecting and deleting / paragraph 2",
                      "fill": "$home-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Deleting your AIHarder account removes its active sign-in data, connection credentials and client authorizations. It does not delete your AimHarder account, cancel your bookings or remove conversations held by an AI provider.",
                      "lineHeight": 1.65,
                      "fontFamily": "Geist",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Y86R0",
                      "name": "Disconnecting and deleting / paragraph 3",
                      "fill": "$home-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Active-data removal and backup expiry are separate. Recovery records used to keep deleted accounts blocked are also separate from active account data.",
                      "lineHeight": 1.65,
                      "fontFamily": "Geist",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "S05Dl",
                  "name": "Privacy section / Questions about your data",
                  "context": "Anchor #contact",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "ORDHR",
                      "name": "Section heading / Questions about your data",
                      "fill": "$home-ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Questions about your data",
                      "lineHeight": 1.25,
                      "fontFamily": "Geist",
                      "fontSize": 26,
                      "fontWeight": "600",
                      "letterSpacing": -0.5
                    },
                    {
                      "type": "text",
                      "id": "HhXpD",
                      "name": "Questions about your data / paragraph 1",
                      "fill": "$home-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Contact us if you have a question about this notice, need help with your information, or want to report a privacy concern. Do not include passwords or other credentials in your message.",
