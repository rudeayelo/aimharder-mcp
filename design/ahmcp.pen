                  "children": [
                    {
                      "type": "text",
                      "id": "T0S6f",
                      "name": "Section heading / Sign-in and security",
                      "fill": "$home-ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Acceso y seguridad",
