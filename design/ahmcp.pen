                      "name": "Sign-in and security / paragraph 2",
                      "fill": "$home-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Utiliza los controles de apps conectadas para revocar el acceso de una app. Mantén tus datos de acceso en privado y contacta con soporte si crees que alguien ha accedido a tu cuenta.",
                      "lineHeight": 1.65,
                      "fontFamily": "Geist",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
