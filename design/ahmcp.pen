                      "fontSize": 26,
                      "fontWeight": "600",
                      "letterSpacing": -0.5
                    },
                    {
                      "type": "text",
                      "id": "J3WaXs",
                      "name": "Sign-in and security / paragraph 1",
                      "fill": "$home-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "El servicio utiliza una sesión del navegador para mantener tu acceso. La autorización de una app de IA es independiente de esa sesión, por lo que cerrar sesión en la web no desconecta tus apps de IA.",
                      "lineHeight": 1.65,
                      "fontFamily": "Geist",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
