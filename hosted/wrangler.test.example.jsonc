{
  // Copy outside the checkout. Resolve the operational IDs there, and make
  // main/migrations_dir absolute before using the external config file.
  "name": "aimharder-mcp-pilot-test",
  "account_id": "REPLACE_WITH_ACCOUNT_ID",
  "main": "./dist/worker.js",
  "no_bundle": true,
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": false },
  "routes": [{ "pattern": "pilot-test.ahmcp.link", "custom_domain": true }],
  "vars": { "LOGNORTH_ENABLED": "false", "BASE_URL": "https://pilot-test.ahmcp.link", "RECOVERY_AUTHORITY_ID": "REPLACE_WITH_PINNED_AUTHORITY_ID" },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "aimharder-mcp-pilot-test-auth",
      "database_id": "REPLACE_WITH_TEST_DATABASE_ID",
      "migrations_dir": "./migrations"
    },
    {
      "binding": "RECOVERY_DB",
      "database_name": "REPLACE_WITH_INDEPENDENT_RECOVERY_DATABASE_NAME",
      "database_id": "REPLACE_WITH_INDEPENDENT_RECOVERY_DATABASE_ID"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNT_CONNECTIONS", "class_name": "AccountConnection" }]
  },
  "migrations": [{ "tag": "v1-account-connection-sqlite", "new_sqlite_classes": ["AccountConnection"] }]
  // AUTH_SECRET must be supplied as a platform secret through a trusted operator
  // context. This anonymous stage has no RESEND_API_KEY secret, MAIL_FROM, Google or vault.
  // The separately authorized mail stage needs a verified MAIL_FROM and a restricted
  // RESEND_API_KEY platform secret. Never place that key in this manifest.
}

// Google stage: inject GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET as platform
// secrets after exact provider callback setup; preserve all existing mail/auth
// secrets. See ../docs/hosted-google.md. No values belong in this manifest.
// Connection stage: review/apply D1 0005 once, and inject independent VAULT_KEYS
// and VAULT_ACTIVE_KEY_ID as protected platform secrets. Namespace creation is
// an operator deployment action; retain SQLite (not legacy new_classes).
// See ../docs/hosted-aimharder-connection.md. Never put keys in this manifest.

// Deletion/restore stage: RECOVERY_DB is independent and MUST NOT be restored
// with AUTH_DB. Bootstrap its pinned head through the trusted operator process;
// missing bindings/head fail closed. See ../docs/hosted-account-deletion.md.

// Optional observability stays disabled. Supply LOGNORTH_API_KEY only as an app-key
// platform secret after separate activation approval, never in this manifest.
