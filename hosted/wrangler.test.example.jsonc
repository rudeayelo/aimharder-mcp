{
  // Copy outside the checkout. Resolve the two operational IDs there, and make
  // main/migrations_dir absolute before using the external config file.
  "name": "aimharder-mcp-pilot-test",
  "account_id": "REPLACE_WITH_ACCOUNT_ID",
  "main": "./dist/worker.js",
  "no_bundle": true,
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "routes": [{ "pattern": "pilot-test.ahmcp.link", "custom_domain": true }],
  "vars": { "BASE_URL": "https://pilot-test.ahmcp.link" },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "aimharder-mcp-pilot-test-auth",
      "database_id": "REPLACE_WITH_TEST_DATABASE_ID",
      "migrations_dir": "./migrations"
    }
  ]
  // AUTH_SECRET must be supplied as a platform secret through a trusted operator
  // context. This anonymous stage has no RESEND_API_KEY secret, MAIL_FROM, Google or vault.
  // The separately authorized mail stage needs a verified MAIL_FROM and a restricted
  // RESEND_API_KEY platform secret. Never place that key in this manifest.
}
